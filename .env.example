# AWS credentials — usa tu perfil local
AWS_PROFILE=default
AWS_REGION=us-east-1

# Logging
CLOUDVIEW_LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:8000

# Optional: host directory with Terraform .tf files to plan inside the api
# container. Defaults to ./tf (empty placeholder in the repo). Replace with
# the absolute path to your real project.
# TF_DIR=/Users/you/code/my-tf-project
